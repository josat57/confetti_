# AI Event Planner - Environment Variables Example
# Copy this file to .env.local and update with your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:9601/api/v1

# For production, use your production API URL:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Note: NEXT_PUBLIC_ prefix makes the variable available in the browser
# Only use this prefix for non-sensitive configuration
