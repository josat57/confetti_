# Docker environment configuration for Confetti frontend
# Usage:
#   1. Copy to .env:   cp .env.docker .env
#   2. Fill in values below
#   3. Run:           docker compose up --build

# ── URLs ──────────────────────────────────────────────────────────────────────
# Point to wherever your backend is running
NEXT_PUBLIC_API_URL=http://localhost:9601/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Paystack (public key only — used in the browser) ──────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_ab0b48aa0c06bbe9188cfc107557d2eee65e3224
