# Docker environment variables for Confetti Client

# Next.js Configuration
# Node Environment
NODE_ENV=production

# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Backend API Configuration
# For Docker: use http://host.docker.internal:9601/api/v1 (macOS/Windows) to reach host machine
# For Docker: use http://backend:9601/api/v1 (if backend service is in docker-compose)
# The NEXT_PUBLIC_API_URL is embedded in the HTML at build time, so it must match where the browser will call from
NEXT_PUBLIC_API_URL=http://host.docker.internal:9601/api/v1

# Add other environment variables as needed
# Copy values from .env.local.example
